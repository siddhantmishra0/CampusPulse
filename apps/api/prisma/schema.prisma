generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  departments        Department[]
  academicYears      AcademicYear[]
  semesters          Semester[]
  subjects           Subject[]
  faculty            Faculty[]
  campaigns          Campaign[]
  issues             Issue[]
  documents          Document[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  studentEnrollments StudentEnrollment[]

  @@map("tenants")
}

model User {
  id            String   @id @default(uuid())
  tenantId      String?
  email         String   @unique
  passwordHash  String
  firstName     String
  lastName      String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  roles  UserRoleMapping[]

  createdCampaigns Campaign[] @relation("CampaignCreator")
  assignedIssues   Issue[]    @relation("IssueAssignee")
  ownedImprovements ImprovementAction[] @relation("ImprovementOwner")

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // PLATFORM_OWNER, INSTITUTION_ADMIN, DEPARTMENT_REVIEWER, FACULTY, STUDENT
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       UserRoleMapping[]
  permissions Permission[]

  @@map("roles")
}

model UserRoleMapping {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id        String   @id @default(uuid())
  roleId    String
  resource  String
  action    String
  createdAt DateTime @default(now())

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
  @@map("permissions")
}

model Department {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  subjects Subject[]
  campaigns Campaign[]
  issues Issue[]
  documents Document[]

  @@index([tenantId])
  @@map("departments")
}

model AcademicYear {
  id        String   @id @default(uuid())
  tenantId  String
  name      String   // e.g., "2024-2025"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  campaigns Campaign[]
  semesters Semester[]

  @@index([tenantId])
  @@map("academic_years")
}

model Semester {
  id             String   @id @default(uuid())
  tenantId       String
  academicYearId String
  name           String   // e.g., "Fall 2024"
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  campaigns    Campaign[]
  studentEnrollments StudentEnrollment[]

  @@index([tenantId])
  @@index([academicYearId])
  @@map("semesters")
}

model Subject {
  id           String   @id @default(uuid())
  tenantId     String
  departmentId String
  name         String
  code         String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  faculty    Faculty[]
  campaigns  Campaign[]
  studentEnrollments StudentEnrollment[]

  @@index([tenantId])
  @@index([departmentId])
  @@map("subjects")
}

model Faculty {
  id           String   @id @default(uuid())
  tenantId     String
  subjectId    String
  userId       String?
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  campaigns Campaign[]

  @@index([tenantId])
  @@index([subjectId])
  @@map("faculty")
}

model StudentEnrollment {
  id           String   @id @default(uuid())
  tenantId     String
  studentId    String   // Student identifier from institution (e.g., matriculation number)
  semesterId   String
  subjectId    String?
  createdAt    DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  semester Semester @relation(fields: [semesterId], references: [id])
  subject  Subject? @relation(fields: [subjectId], references: [id])

  @@index([tenantId])
  @@index([semesterId])
  @@map("student_enrollments")
}

model Campaign {
  id                 String   @id @default(uuid())
  tenantId           String
  title              String
  description        String?
  campaignType       String   // SUBJECT, FACULTY, DEPARTMENT, SERVICE, CUSTOM
  academicYearId     String?
  semesterId         String?
  departmentId       String?
  subjectId          String?
  facultyId          String?
  eligibilityRule    Json?
  isAnonymous        Boolean  @default(true)
  allowConversational Boolean @default(true)
  allowTraditional   Boolean  @default(true)
  startAt            DateTime
  endAt              DateTime
  status             String   @default("DRAFT") // DRAFT, SCHEDULED, ACTIVE, CLOSED, ARCHIVED
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])
  semester     Semester?     @relation(fields: [semesterId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  subject      Subject?      @relation(fields: [subjectId], references: [id])
  faculty      Faculty?      @relation(fields: [facultyId], references: [id])
  createdBy    User          @relation("CampaignCreator", fields: [createdById], references: [id])

  eligibilityRules   CampaignEligibility[]
  feedbackSubmissions FeedbackSubmission[]
  conversations      Conversation[]
  issueSources       Issue[] @relation("IssueSourceCampaigns")

  @@index([tenantId])
  @@index([status])
  @@index([departmentId])
  @@map("campaigns")
}

model CampaignEligibility {
  id         String   @id @default(uuid())
  campaignId String
  studentId  String   // Internal or external student ID
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, studentId])
  @@map("campaign_eligibility")
}

model FeedbackSubmission {
  id                  String   @id @default(uuid())
  campaignId          String
  submissionTokenHash String?  @unique // For anonymity
  submittedAt         DateTime @default(now())
  source              String   // CONVERSATIONAL, TRADITIONAL
  
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  analysis   FeedbackAnalysis?
  responses  FeedbackResponse[]

  @@index([campaignId])
  @@map("feedback_submissions")
}

model FeedbackResponse {
  id                   String   @id @default(uuid())
  feedbackSubmissionId String
  question             String?
  answer               String
  createdAt            DateTime @default(now())

  submission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)

  @@index([feedbackSubmissionId])
  @@map("feedback_responses")
}

model Conversation {
  id         String   @id @default(uuid())
  campaignId String
  sessionId  String   // Anonymous session identifier
  status     String   @default("ACTIVE") // ACTIVE, SUBMITTED, ABANDONED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages ConversationMessage[]

  @@index([campaignId])
  @@index([sessionId])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String   // SYSTEM, ASSISTANT, USER
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_messages")
}

model FeedbackAnalysis {
  id                   String   @id @default(uuid())
  feedbackSubmissionId String   @unique
  sentiment            String   // POSITIVE, NEGATIVE, NEUTRAL, MIXED
  summary              String?
  modelVersion         String
  analyzedAt           DateTime @default(now())
  status               String   @default("COMPLETED") // PENDING, COMPLETED, FAILED

  submission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)
  topics     FeedbackTopic[]
  issues     FeedbackIssue[]

  @@index([sentiment])
  @@map("feedback_analyses")
}

model FeedbackTopic {
  id                 String   @id @default(uuid())
  feedbackAnalysisId String
  name               String
  confidence         Float?
  createdAt          DateTime @default(now())

  analysis FeedbackAnalysis @relation(fields: [feedbackAnalysisId], references: [id], onDelete: Cascade)

  @@index([feedbackAnalysisId])
  @@index([name])
  @@map("feedback_topics")
}

model FeedbackIssue {
  id                 String   @id @default(uuid())
  feedbackAnalysisId String
  title              String
  description        String
  category           String
  createdAt          DateTime @default(now())

  analysis FeedbackAnalysis @relation(fields: [feedbackAnalysisId], references: [id], onDelete: Cascade)

  @@index([feedbackAnalysisId])
  @@map("feedback_issues")
}

model Issue {
  id                   String   @id @default(uuid())
  tenantId             String
  title                String
  description          String
  category             String
  sourceFeedbackCount  Int      @default(0)
  sentimentDistribution Json?
  assignedDepartmentId String?
  assignedReviewerId   String?
  status               String   @default("IDENTIFIED") // IDENTIFIED, UNDER_REVIEW, ACTION_PLANNED, IN_PROGRESS, RESOLVED, ARCHIVED
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant             Tenant      @relation(fields: [tenantId], references: [id])
  assignedDepartment Department? @relation(fields: [assignedDepartmentId], references: [id])
  assignedReviewer   User?       @relation("IssueAssignee", fields: [assignedReviewerId], references: [id])
  sourceCampaigns    Campaign[]  @relation("IssueSourceCampaigns")
  actions            ImprovementAction[]

  @@index([tenantId])
  @@index([status])
  @@index([assignedDepartmentId])
  @@map("issues")
}

model ImprovementAction {
  id          String   @id @default(uuid())
  issueId     String
  title       String
  description String
  ownerId     String?
  targetDate  DateTime?
  status      String   @default("PLANNED") // PLANNED, IN_PROGRESS, COMPLETED, CANCELLED
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  owner User? @relation("ImprovementOwner", fields: [ownerId], references: [id])

  publishedUpdates PublishedUpdate[]

  @@index([issueId])
  @@index([ownerId])
  @@map("improvement_actions")
}

model PublishedUpdate {
  id                  String   @id @default(uuid())
  tenantId            String
  improvementActionId String
  title               String
  content             String
  publishedAt         DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  action ImprovementAction @relation(fields: [improvementActionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("published_updates")
}

model Document {
  id           String   @id @default(uuid())
  tenantId     String
  departmentId String?
  title        String
  description  String?
  type         String   // POLICY, SYLLABUS, GUIDELINE, REPORT, OTHER
  status       String   @default("UPLOADED") // UPLOADED, PROCESSING, READY, FAILED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  versions   DocumentVersion[]

  @@index([tenantId])
  @@index([departmentId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(uuid())
  documentId   String
  versionNumber Int
  fileUrl      String
  uploadedBy   String?
  createdAt    DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   DocumentChunk[]

  @@unique([documentId, versionNumber])
  @@map("document_versions")
}

model DocumentChunk {
  id                String   @id @default(uuid())
  tenantId          String
  documentVersionId String
  chunkText         String
  embedding         Unsupported("vector(1536)")? // Using pgvector
  pageNumber        Int?
  metadata          Json?
  createdAt         DateTime @default(now())

  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([documentVersionId])
  @@map("document_chunks")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  actorId   String?
  action    String
  resource  String
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}
